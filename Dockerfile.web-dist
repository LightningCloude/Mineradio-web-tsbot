FROM nginx:1.30.2-alpine

COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY web/dist /usr/share/nginx/html
COPY LICENSE THIRD_PARTY_NOTICES.md /usr/share/licenses/tsbot/
COPY LICENSES /usr/share/licenses/tsbot/LICENSES

EXPOSE 8080

HEALTHCHECK --interval=20s --timeout=10s --start-period=30s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/ && wget -q -O /dev/null http://127.0.0.1:8080/api/health/ready

CMD ["nginx", "-g", "daemon off;"]
