# TSBot 统一环境变量模板
# 这个文件同时给后端、Web 前端、voice-service 使用。
# 使用方式：
# 1. 复制为 tsbot.env
# 2. 按你的服务器环境修改下面的值
# 3. 再启动后端、Web 前端和 voice-service

# =========================
# 后端服务监听配置
# =========================

# 后端 HTTP 服务监听地址。
# 本机反向代理时通常填 127.0.0.1；需要直接对局域网或公网开放时可改成 0.0.0.0。
export TSBOT_HOST="127.0.0.1"

# 后端 HTTP 服务端口。
# Web 前端、脚本和外部调用方都会通过这个端口访问后端。
export TSBOT_PORT="8009"

# 后端连接 voice-service 使用的 gRPC 地址。
# 一般保持本机回环地址即可，除非你把 voice-service 单独部署到别的机器。
export TSBOT_VOICE_GRPC_ADDR="127.0.0.1:50051"

# 用于加密保存管理员 Cookie、密钥等敏感信息，至少 32 个字符。
# 可用 `openssl rand -hex 32` 分别生成以下三个值；模板故意留空以避免
# 示例凭据被误用于生产。
export TSBOT_COOKIE_KEY=""

# 后端接口共享访问令牌。
# 默认启用失败关闭鉴权。普通接口需要带 Authorization: Bearer <token>
# 或 x-api-token；只有隔离的本地开发环境才应设为 false。
export TSBOT_REQUIRE_API_AUTH="true"
# 只有一个令牌时使用 TSBOT_API_TOKEN；需要同时兼容多个调用方时使用 TSBOT_API_TOKENS。
export TSBOT_API_TOKEN=""
# export TSBOT_API_TOKENS="token_a,token_b"

# 当前原生 Web 控制台的管理员操作使用 x-admin-token；后端也支持安全
# 管理员会话。建议为 Web 控制台配置独立的长随机值。
export TSBOT_ADMIN_TOKEN=""

# 跨域默认关闭。只有确实存在独立前端域名时才填写完整 HTTPS Origin，
# 多个值以逗号分隔；同源 Web 和 Vite 代理无需配置。
# export TSBOT_CORS_ORIGINS="https://music.example.com"


# =========================
# TeamSpeak / TS6 主客户端配置
# =========================

# TeamSpeak 服务器地址。
# voice-service 会作为一个真正的客户端连到这里，而不是走网页协议。
export TSBOT_TS3_HOST="your_teamspeak_server_ip"

# TeamSpeak 语音服务器端口，默认一般是 9987。
export TSBOT_TS3_PORT="9987"

# 机器人进入服务器后显示的昵称。
export TSBOT_TS3_NICKNAME="tsbot"

# 机器人启动后要进入的频道 ID。
# 如果你更习惯按频道路径进频道，也可以只配下面的 TSBOT_TS3_CHANNEL_PATH。
export TSBOT_TS3_CHANNEL_ID="2"

# TeamSpeak 身份文件保存路径。
# 首次连接成功后会在这里生成或复用 identity，避免每次启动都被识别成新客户端。
export TSBOT_TS3_IDENTITY_FILE="./logs/identity.json"

# 直接填写 TeamSpeak identity 字符串。
# 如果同时设置了 TSBOT_TS3_IDENTITY 和 TSBOT_TS3_IDENTITY_FILE，通常优先使用显式内容。
# export TSBOT_TS3_IDENTITY=""

# TeamSpeak 服务器密码。
# 你的 TS 服务器没有总密码时可以留空。
# export TSBOT_TS3_SERVER_PASSWORD=""

# 目标频道密码。
# 如果机器人进入的频道有密码，需要在这里填写。
# export TSBOT_TS3_CHANNEL_PASSWORD=""

# 目标频道路径。
# 当频道 ID 不固定、或你更习惯按层级路径进频道时可以使用，例如 "大厅/音乐频道"。
# export TSBOT_TS3_CHANNEL_PATH=""

# 是否允许机器人直接通过客户端自身的 clientupdate 写入简介。
# 新版逻辑通常比旧式 ServerQuery 方式更稳定。
# export TSBOT_TS3_ALLOW_DIRECT_CLIENTUPDATE_DESCRIPTION="1"

# 机器人客户端简介标题。
# 会显示在频道内的客户端资料里，支持用 \n 表示换行。
# export TSBOT_TS3_CLIENT_DESCRIPTION_TITLE="Yumi TSBot"

# 机器人客户端简介正文。
# 可用于写使用说明、命令提示、服务器信息等，支持用 \n 表示换行。
# export TSBOT_TS3_CLIENT_DESCRIPTION_INTRO="TeamSpeak 音乐机器人\\n支持网易云 / QQ 音乐 / B站"

# 机器人头像单文件路径。
# 设置后优先使用这张图片作为头像。
# export TSBOT_TS3_AVATAR_FILE="./assets/avatar.png"

# 机器人头像目录。
# 当没有设置单文件头像时，会从这个目录里挑第一张可用图片。
# export TSBOT_TS3_AVATAR_DIR="./assets/avatars"


# =========================
# 旧版 ServerQuery 兼容配置
# =========================

# 下面这些变量仅在老旧 TeamSpeak 服务器需要回退到传统 ServerQuery 时才使用。
# 它们不是 TS6 的 HTTP(S) Query 接口，也不是常规部署的必填项。

# ServerQuery 用户名。
# export TSBOT_TS3_SERVERQUERY_USER=""

# ServerQuery 密码。
# export TSBOT_TS3_SERVERQUERY_PASSWORD=""

# ServerQuery 主机地址。
# export TSBOT_TS3_SERVERQUERY_HOST=""

# ServerQuery 端口，常见默认值是 10011。
# export TSBOT_TS3_SERVERQUERY_PORT="10011"

# ServerQuery 使用的虚拟服务器 SID。
# export TSBOT_TS3_SERVERQUERY_SID=""

# 某些旧服务器需要显式指定语音端口映射。
# export TSBOT_TS3_SERVERQUERY_USE_PORT="9987"


# =========================
# Web 生产预览 / 常驻服务配置
# =========================

# Web 前端预览服务监听地址。
# run-web.sh、nohup-start.sh、Docker 预览模式都会使用这组配置。
export TSBOT_WEB_HOST="127.0.0.1"

# Web 前端预览服务端口。
# 如果你打算让 Nginx、Caddy 或宝塔反代这个页面，这里通常配一个本机端口即可。
export TSBOT_WEB_PORT="8080"

# Web 预览模式反代到后端的目标地址。
# 默认可不写，程序会按 TSBOT_HOST / TSBOT_PORT 推导。
# 当后端和 Web 不在同一个地址时，再手动指定这里。
# export TSBOT_WEB_API_PROXY_TARGET="http://127.0.0.1:8009"

# 仅在开发/验收时把 Vite 代理目标指向另一个完整 Web 网关才启用。
# 启用后 /api 前缀会原样转发；直接连接 FastAPI 后端时必须保持关闭。
# export TSBOT_WEB_PROXY_PRESERVE_API_PREFIX="0"

# 允许访问 Web 的 Host 白名单。
# 当你通过域名访问 Vite 预览服务或 Docker 内 Web 服务时，建议填写实际域名，多个值用逗号分隔。
# export TSBOT_WEB_ALLOWED_HOSTS="dev.example.com,.example.com"


# =========================
# 预构建镜像拉取配置
# =========================

# 下面这组变量用于 docker-compose.prebuilt.yml。
# 如果你不想本地编译镜像，而是想直接拉取预构建镜像，可以在这里指定仓库信息。

# 镜像仓库域名，例如 docker.io 或 ghcr.io。默认使用本项目 GHCR 镜像。
# export TSBOT_IMAGE_REGISTRY="ghcr.io"

# 镜像命名空间 / 用户名 / 组织名。
# export TSBOT_IMAGE_NAMESPACE="lightningcloude"

# 镜像仓库前缀名。
# 实际会拼出后端、Web 前端、voice-service 三个镜像。
# export TSBOT_IMAGE_REPO="mineradio-web-tsbot"

# 镜像标签。
# 例如 latest、main、某个版本号或 commit tag。
# export TSBOT_IMAGE_TAG="latest"


# =========================
# Web 安全发布工具（可选）
# =========================

# deploy-web.sh / deploy-web.ps1 使用的 SSH 主机和用户。
# 未设置主机时必须通过 --host 显式传入；工具默认只做只读 dry-run。
# export TSBOT_DEPLOY_HOST="music.example.com"
# export TSBOT_DEPLOY_USER="ubuntu"
# export TSBOT_DEPLOY_PORT="22"

# 部署后执行协议与浏览器验收的公开 Web 地址。
# 留空时按 http://<TSBOT_DEPLOY_HOST>:8080 推导。
# export TSBOT_DEPLOY_PUBLIC_URL="https://music.example.com"

# 正在运行的 Compose Web 容器名。只有名称与默认值不同时才需要设置。
# export TSBOT_DEPLOY_WEB_CONTAINER="tsbot-v061-linux-amd64-web-1"

# 隔离发布故障演练使用的现有 Nginx 兼容基础镜像。
# 演练器不会自动拉取镜像，执行前会用 docker image inspect 确认它存在。
# export TSBOT_DRILL_BASE_IMAGE="minerats-web:dependency-base-version"


# =========================
# Web 开发环境配置
# =========================

# Vite 开发服务器监听地址。
# 本机开发一般用 127.0.0.1；需要局域网访问调试时可改成 0.0.0.0。
export VITE_DEV_HOST="127.0.0.1"

# Vite 开发服务器端口。
export VITE_DEV_PORT="5173"

# 前端请求后端的基础地址。
# 推荐默认值是同源的 /api，这样开发模式、预览模式和 Docker 都能统一通过代理转发到后端。
export VITE_API_BASE="/api"

# 前端对外公开访问的完整网址。
# 用于生成 canonical、og:url，也会自动补到 allowed hosts。
# export VITE_WEB_PUBLIC_URL="https://music.example.com"

# 前端显示名称。
# 会影响浏览器标题、侧边栏品牌名等界面文字。
# export VITE_WEB_APP_NAME="Yumi TSBot"

# 前端图标地址。
# 可填写完整 URL，也可以填写以 / 开头的站内路径。
# export VITE_WEB_APP_ICON="/favicon.ico"

# API Token 不写入前端构建产物。首次打开 Web 后在“访问设置”中保存，
# 它只会进入当前浏览器的 localStorage。


# =========================
# 音乐源与业务配置
# =========================

# 网易云功能依赖你自行部署的 NeteaseCloudMusicApi 地址。
# 后端会通过这个地址执行搜索、播放链接、歌单、歌词等网易云相关请求。
export TSBOT_NETEASE_API_BASE="http://127.0.0.1:3000/"

# 单个 B 站视频允许点播的最长时长，单位为分钟。
# 设为 0 表示不限制。建议保留限制，避免超长视频占用下载和播放资源。
# export TSBOT_BILIBILI_MAX_DURATION_MINUTES="180"

# B站音频写入本地缓存时的全局带宽与并发限制。默认单任务 512 KiB/s，
# 且服务器同时只下载一个视频，避免后台缓存挤占播放和 Web 流量。
# export TSBOT_BILIBILI_DOWNLOAD_RATE_KBPS="512"
# export TSBOT_BILIBILI_DOWNLOAD_CONCURRENCY="1"

# QQ 音乐管理员 Cookie、网易云管理员 Cookie、B站管理员 Cookie
# 都建议通过 Web 控制台或 admin API 写入数据库。
# 它们会使用上面的 TSBOT_COOKIE_KEY 加密存储，因此这里通常不需要明文填写。


# =========================
# 数据库配置
# =========================

# 数据库连接串。
# 默认使用项目根目录下的 SQLite 文件；如果你要换成别的数据库，请改成对应驱动的连接串格式。
export DATABASE_URL="sqlite:///./tsbot.db"


# =========================
# 调试与日志配置
# =========================

# 是否启用开发调试模式。
# true 时通常会打开更详细的错误和调试行为；生产环境建议保持 false。
export DEBUG=false

# 后端日志等级。
# 常用值：DEBUG、INFO、WARNING、ERROR。
export TSBOT_LOG_LEVEL="INFO"

# 后端日志文件路径。
# nohup 启动、排查接口问题时通常会看这个文件。
export TSBOT_LOG_FILE="logs/backend.log"

# 前端日志等级。
# 主要用于 Web 侧调试输出控制。
export VITE_LOG_LEVEL="INFO"
